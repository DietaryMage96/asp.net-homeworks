@{
    int id = ViewBag.ProductId;
}

@switch (id)
{
    case 1:
        <h2>Ноутбук</h2>
        <p><strong>Опис:</strong> Потужний ноутбук для роботи, навчання та ігор.</p>
        <p><strong>Ціна:</strong> 35 000 грн</p>
        break;

    case 2:
        <h2>Смартфон</h2>
        <p><strong>Опис:</strong> Сучасний смартфон із чудовим екраном та якісною камерою.</p>
        <p><strong>Ціна:</strong> 22 000 грн</p>
        break;

    case 3:
        <h2>Бездротові навушники</h2>
        <p><strong>Опис:</strong> Навушники з активним шумозаглушенням та чистим звуком.</p>
        <p><strong>Ціна:</strong> 4 500 грн</p>
        break;

    default:
        <h2>Товар не знайдено</h2>
        <p>На жаль, товару з ID @id не існує в каталозі.</p>
        break;
}

<hr />